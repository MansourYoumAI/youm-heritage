# Supabase — créez un projet sur https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_clé_anon_publique

# Clé service (ne pas exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=votre_clé_service_role

# Authentification de l'application
# Mot de passe pour accéder à l'application familiale
SITE_PASSWORD=njaboot

# Secret pour signer les tokens de session (chaîne aléatoire de 32+ caractères)
SESSION_SECRET=changez-moi-en-production-utilisez-une-chaine-aleatoire

# URL de déploiement (pour Vercel ou Netlify)
NEXT_PUBLIC_SITE_URL=https://votre-domaine.vercel.app
