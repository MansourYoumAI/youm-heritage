# Supabase — créez un projet sur https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# Clé service (ne JAMAIS exposer côté client — utilisée uniquement dans les API routes)
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role

# Mot de passe du mode administrateur
# Lorsque fourni dans la modale admin, ouvre le cookie HMAC pour editer/supprimer.
ADMIN_PASSWORD=choisir-un-mot-de-passe-fort

# Secret pour signer le cookie admin (HMAC-SHA256)
# Chaine aleatoire d'au moins 32 caracteres. Ne jamais commiter.
SESSION_SECRET=remplacer-par-une-chaine-aleatoire-forte-de-32-caracteres-minimum

# URL de deploiement (pour Netlify)
NEXT_PUBLIC_SITE_URL=https://youm.info
